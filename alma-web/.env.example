# Copia este archivo como .env.local y completa las claves.

# --- Cerebro de Alma (chat) · OpenRouter ---
# Clave en https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# --- Voz natural: completa UNA de las opciones ---
# Para elegir a mano cuál usar cuando hay más de una: TTS_PROVIDER=azure | elevenlabs | openai
# TTS_PROVIDER=elevenlabs

# ElevenLabs (https://elevenlabs.io/app/settings/api-keys). Solo la clave es obligatoria.
ELEVENLABS_API_KEY=
# Id de una voz en español de tu "My Voices" (elevenlabs.io/app/voice-library). Sin esto usa una voz básica.
# ELEVENLABS_VOICE_ID=
# eleven_v3 (la más expresiva: dice cada frase con el ánimo de Alma, ~1,5 s más lenta),
# eleven_multilingual_v2 (por defecto) o eleven_flash_v2_5 (más rápida y barata)
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Azure Speech: voz chilena "Catalina"
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# AZURE_SPEECH_VOICE=es-CL-CatalinaNeural

# OpenAI
# OPENAI_API_KEY=
